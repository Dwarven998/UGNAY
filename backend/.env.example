# Copy this file to .env (in this same backend/ directory) and fill in real values.
# .env is gitignored and must never be committed.

# Supabase PostgreSQL
DB_URL=jdbc:postgresql://<host>:<port>/postgres?sslmode=require&preferQueryMode=simple&prepareThreshold=0
DB_USERNAME=
DB_PASSWORD=

# JWT — any long random string
JWT_SECRET=

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Facebook (from the Facebook App dashboard)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Must match the OAuth redirect URI configured in the Facebook App dashboard.
# For local dev this is usually an ngrok tunnel, e.g. https://<your-subdomain>.ngrok-free.dev/api/auth/facebook/callback
FACEBOOK_OAUTH_REDIRECT_URI=

# App / CORS
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
