# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.
# Without these, image uploads silently fall back to a local blob: URL
# that only works in your own browser tab — everyone else sees a broken image.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_BUCKET=media
